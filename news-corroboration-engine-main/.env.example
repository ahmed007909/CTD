DATABASE_PATH=data/news.db
POLL_INTERVAL_SECONDS=120
INGESTION_ENABLED=true
SCRAPING_ENABLED=true
ARTICLE_MAX_AGE_DAYS=7
MAX_INDEX_ARTICLES=5000
CACHE_TTL_SECONDS=120
SNIPPET_MAX_CHARS=500
# Install .[semantic], then enable multilingual sentence embeddings.
SEMANTIC_ENABLED=false
LIVE_SEARCH_ENABLED=true
# Optional custom path; aliases can also be edited in news_engine/config/search_aliases.json.
# SEARCH_ALIASES_PATH=news_engine/config/search_aliases.json
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional installed spaCy model; rule-based candidate extraction is the default.
SPACY_MODEL=
# Remote clients are rejected unless PUBLIC_MODE=true (requires HTTPS).
PUBLIC_MODE=false
# Public mode requires a random key of at least 32 ASCII characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Both must remain false in public mode; opt in only for private local use.
SAVE_HISTORY=false
CACHE_QUERIES=false
HISTORY_RETENTION_DAYS=30
REQUESTS_PER_MINUTE=120
GLOBAL_REQUESTS_PER_MINUTE=600
QUERIES_PER_MINUTE=20
GLOBAL_QUERIES_PER_MINUTE=60
MAX_ACTIVE_REQUESTS=8
MAX_WEBSOCKETS=20
